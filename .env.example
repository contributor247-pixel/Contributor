# Neon Postgres connection string (see docs/04_MasterBuildGuide.md Step 0.4)
DATABASE_URL=

# Auth.js v5 session encryption secret (openssl rand -base64 32)
AUTH_SECRET=

# Base URL of the app, used by Auth.js for callbacks
AUTH_URL=http://localhost:3000

# Stripe test-mode keys (Step 0.5)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret, from `stripe listen` locally or the
# dashboard in production (blank until Step 7/17)
STRIPE_WEBHOOK_SECRET=

# Gmail SMTP (via nodemailer) for transactional email — OTP codes,
# verification links, receipts, moderation/invite notices (Step 0.6).
# EMAIL_USER must be a real Gmail address; EMAIL_PASS must be a 16-char
# "App Password" (Google Account -> Security -> 2-Step Verification ->
# App passwords), NOT your normal Gmail password. Gmail only allows
# sending "from" the authenticated EMAIL_USER address itself, so
# EMAIL_FROM's display name is kept but its address is overridden to
# EMAIL_USER at send time.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Contributor <youraddress@gmail.com>
